{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cBioPortal/cohort-lab/docs/cohort-query.schema.json",
  "title": "Cohort Query",
  "description": "A patient cohort defined by temporal relationships between clinical timeline events. Semantics: docs/dsl.md.",
  "type": "object",
  "required": ["a", "rel"],
  "additionalProperties": false,
  "properties": {
    "a": { "$ref": "#/$defs/selector", "description": "Anchor event selector (A)" },
    "b": {
      "oneOf": [{ "$ref": "#/$defs/selector" }, { "type": "null" }],
      "description": "Second event selector (B); required unless rel.type is NONE"
    },
    "rel": { "$ref": "#/$defs/relation" },
    "priorGuard": {
      "type": "boolean", "default": false,
      "description": "Restrict to patients NLP-flagged 'No prior medications' (makes 'first' mean first)"
    },
    "lineGap": {
      "type": "number", "minimum": 1, "maximum": 3650, "default": 90,
      "description": "Treatment-free gap (days) that starts a new derived treatment line"
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "required": ["eventType"],
      "additionalProperties": false,
      "properties": {
        "eventType": {
          "type": "string", "minLength": 1, "maxLength": 200,
          "description": "Event type from the study catalog, or 'Treatment line (derived)'"
        },
        "attrs": {
          "type": "array", "maxItems": 3, "default": [],
          "items": {
            "type": "object",
            "required": ["key", "value"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "maxLength": 200 },
              "value": { "type": "string", "maxLength": 500 }
            }
          },
          "description": "String-equality attribute filters, ANDed"
        },
        "numeric": {
          "oneOf": [
            {
              "type": "object",
              "required": ["key", "op", "value"],
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string", "maxLength": 200 },
                "op": { "enum": [">", ">=", "<", "<=", "="] },
                "value": { "type": "number" }
              }
            },
            { "type": "null" }
          ],
          "description": "Numeric predicate on an attribute value (toFloat64OrNull cast; non-numeric values never match)"
        },
        "occurrence": {
          "enum": ["ANY", "FIRST", "LAST"], "default": "ANY",
          "description": "Pin to one event per patient before the relation is evaluated"
        },
        "minDurationDays": {
          "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }],
          "description": "Only events with stop_date - start_date >= N (needs a stop date)"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["NONE", "BEFORE", "DURING", "NOT_FOLLOWED_BY"] },
        "minDays": { "type": "number", "minimum": 0, "default": 0, "description": "BEFORE: exclusive lower bound offset from A.start" },
        "maxDays": { "type": "number", "minimum": 0, "description": "BEFORE: inclusive upper bound offset from A.start (required)" },
        "withinDays": { "type": "number", "minimum": 1, "description": "NOT_FOLLOWED_BY: absence window after A.start (required)" },
        "observed": { "type": "boolean", "default": false, "description": "NOT_FOLLOWED_BY: require follow-up past the window (recommended: true)" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "BEFORE" } } }, "then": { "required": ["maxDays"] } },
        { "if": { "properties": { "type": { "const": "NOT_FOLLOWED_BY" } } }, "then": { "required": ["withinDays"] } }
      ]
    }
  }
}

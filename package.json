{
  "name": "cbio-lab",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "mcp": "node mcp/server.ts",
    "docs:gen": "node scripts/gen-dsl-doc.ts",
    "style:gen": "node scripts/gen-style.ts",
    "docs:check": "node --env-file=.env.local scripts/check-dsl-doc.ts",
    "docs:counts": "UPDATE_COUNTS=1 node --env-file=.env.local scripts/check-dsl-doc.ts",
    "check:methods": "node --env-file=.env.local scripts/check-method-scripts.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint . && knip && npm run lint:py",
    "lint:py": "python/.venv/bin/ruff check python",
    "report:dupes": "jscpd",
    "report:security": "uvx semgrep@1.180.0 scan --metrics off --config p/typescript --config p/nodejs --config p/react --config p/nextjs --config p/sql-injection --config p/secrets --config p/python --text --sarif-output=quality-report/semgrep.sarif",
    "test:boundary": "node --test test/boundary.test.ts",
    "test:db": "node --test test/postgres.db-test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:status": "node --env-file-if-exists=.env.local scripts/db-migrate.ts --status",
    "db:claim-legacy": "node --env-file-if-exists=.env.local scripts/claim-legacy.ts",
    "test:python": "python/.venv/bin/python -m unittest discover -s python/tests -v",
    "check:genefacets": "node --env-file=.env.local scripts/check-gene-facets.ts",
    "check:values": "node --env-file=.env.local scripts/check-value-folding.ts",
    "check:denominators": "node --env-file=.env.local scripts/check-denominators.ts",
    "denominators:pin": "UPDATE_DENOM=1 node --env-file=.env.local scripts/check-denominators.ts",
    "check:splitby-perf": "node --env-file=.env.local scripts/check-splitby-perf.ts",
    "check:portal": "node --env-file=.env.local scripts/check-portal-parity.ts",
    "check:cohorts": "node --env-file=.env.local scripts/check-cohort-logic.ts",
    "check:access-mutants": "node scripts/check-access-mutants.ts",
    "check:mutants": "node --env-file=.env.local scripts/check-mutants.ts",
    "verify": "npm test && npm run check:methods && RECORD=1 npm run check:portal && RECORD=1 npm run check:cohorts && RECORD=1 npm run check:mutants",
    "visual": "node scripts/visual.ts",
    "check:figures": "node --env-file=.env.local scripts/check-figures.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.115",
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/react": "^4.0.143",
    "@aws-sdk/credential-provider-node": "^3.972.86",
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@tanstack/react-query": "^5.104.1",
    "ai": "^7.0.140",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "4.0.2",
    "express": "^5.2.1",
    "lucide-react": "^1.56.0",
    "marked": "^18.0.11",
    "mcp-handler": "^1.1.0",
    "mermaid": "^11.17.2",
    "next": "^16.3.6",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.3",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jose": "^6.2.12",
    "jscpd": "5.4.1",
    "knip": "^6.41.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.30",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}

# Copy to .env.local (gitignored) and fill in. See docs/ENVIRONMENT.md for every setting.

# --- Required: the cBioPortal ClickHouse warehouse ---
CLICKHOUSE_URL=https://<host>:8443
CLICKHOUSE_USER=<read-only user>
CLICKHOUSE_PASSWORD=<password>
CLICKHOUSE_DB=cbioportal_public_librechat_blue

# Optional: name of this database in the UI (default: primary)
# CLICKHOUSE_LABEL=primary
